# Copy to .env and fill in what you need. Every value is optional for local development.

# --- Database ---------------------------------------------------------------
# Leave unset to use the embedded local Postgres (PGlite) stored in .data/pglite.
# Set to a free cloud Postgres (Neon or Supabase) connection string to use that instead.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Required in production. On Supabase use the pooler's "Transaction" connection string (port 6543).
# DATABASE_POOL_SIZE=5
# Optional separate connection for `npm run db:migrate` (e.g. Supabase "Session" pooler, port 5432).
# MIGRATION_DATABASE_URL=

# --- Sign-in ----------------------------------------------------------------
# Required in production. Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=
# First admin accounts (comma-separated emails); additional admins and Plus memberships
# are managed from /admin after those users have signed in once.
# ADMIN_EMAILS=admin@example.com

# Google OAuth (optional). Create an OAuth 2.0 Client ID (Web application) in
# Google Cloud Console. Authorized redirect URI for local Vite:
#   http://localhost:5173/api/v1/auth/google/callback
# Production: https://your-domain.example/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile on the sign-in page (free). Create a Managed widget at
# https://dash.cloudflare.com/?to=/:account/turnstile and allow your hostnames
# (localhost for local development, designrounds.in in production). Most visitors
# pass silently; suspicious ones get a checkbox. The site key is public. The secret
# stays on the server. Production refuses email and Google sign-in until both are set.
# These dummy keys show the checkbox locally and always pass. They are not for production.
# TURNSTILE_SITE_KEY=3x00000000000000000000FF
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email OTP: with no provider configured (and NODE_ENV not production), codes are
# printed in the API terminal and shown on the sign-in screen.

# Option A: SMTP, e.g. Gmail with an app password (https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=DesignRounds <you@gmail.com>

# Option B: Resend (https://resend.com). Without a verified domain it only delivers to your own address.
# RESEND_API_KEY=
# EMAIL_FROM=DesignRounds <onboarding@resend.dev>

# --- AI ---------------------------------------------------------------------
# Leave AI_PROVIDER and AI_API_KEY unset in development to use the built-in fake
# provider, which returns clearly labelled sample reviews. In production AI stays off
# until configured. Run `npm run ai:check` after changing any of these.
#
# Google Cloud Vertex AI. Interviewer chat uses the chat model; the final review and
# its communication feedback use the review model. Enable the Vertex AI API first.
# AI_PROVIDER=gemini-vertex        # Gemini, billed to Google Cloud (trial credit applies)
# AI_PROVIDER=anthropic-vertex     # Claude; needs a paid billing account and Model Garden access
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_REGION=global             # "global" is recommended (preview models are often global-only)
# Defaults: gemini-vertex = gemini-3.8-flash / gemini-3.1-pro-preview,
#           anthropic-vertex = claude-haiku-5-5 / claude-sonnet-5-5
# AI_CHAT_MODEL=
# AI_REVIEW_MODEL=
# gemini-vertex chat falls back to a generally available model in Mumbai when the chat
# model has not started replying in time (off disables it):
# AI_CHAT_REGION=us                # gemini-vertex chat location (3.8 Flash: us, eu or global)
# AI_CHAT_FALLBACK_MODEL=gemini-3.5-flash
# AI_CHAT_FALLBACK_REGION=asia-south1
# AI_CHAT_FALLBACK_AFTER_MS=5000
#
# Google Cloud credentials, first match wins (see server/modules/ai/gcp-auth.js):
#  1. Vercel OIDC federation (production; no long-lived key):
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
# GCP_SERVICE_ACCOUNT_EMAIL=designrounds-ai@your-gcp-project-id.iam.gserviceaccount.com
#  2. A service-account JSON key, raw or base64 (local development):
# GCP_SERVICE_ACCOUNT_KEY=
#  3. Neither: Application Default Credentials (`gcloud auth application-default login`).
#
# Free development key: Google AI Studio (https://aistudio.google.com/apikey).
# Free-tier requests may be used by Google to improve its products: use test data only.
# AI_API_KEY=
# AI_MODEL=gemini-3.8-flash      # run `npm run ai:check` to list models your key can use
#
# Any other OpenAI-compatible API works the same way, e.g. Groq:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
#
# Optional tuning (defaults shown):
# AI_PROVIDER=                   # gemini-vertex | anthropic-vertex | openai-compat | fake
# AI_REVIEW_EFFORT=medium        # reasoning effort: low | medium | high
# AI_INTERVIEWER_EFFORT=         # Vertex: low; others: none (starts the first word sooner)
# AI_REVIEW_MAX_TOKENS=          # Claude: 16000; others: 12000
# AI_REVIEW_TIMEOUT_MS=          # Claude: 180000; others: 120000

# Reference answer pools. A new or edited question is queued on startup.
# Production builds the queue. Locally, set build or run `npm run answers:build`.
# ANSWER_POOLS=build
# ANSWER_POOLS=off

# --- Interview intelligence (v3 interviewer) ----------------------------------
# docs/design/: the Interview Conductor runs a round when this is on AND the question
# has a published Problem Pack; otherwise the v2 interviewer runs. On in development;
# production and previews opt in. A round keeps the interviewer it started with.
# INTERVIEWER_V3=true
#
# Problem Packs: hand-authored ones (server/content/packs/*.json) are published on
# startup; other questions are queued for a build. Building calls the review model,
# so it only happens with PROBLEM_PACKS=build (long-running worker and the daily cron)
# or from Admin -> Interviewer packs -> Build now. Built packs wait for admin review.
# PROBLEM_PACKS=build
# PROBLEM_PACKS_AUTOPUBLISH=on   # development only: publish built packs without review
# Build pack files for a pull request: npm run packs:build -- <prompt-id> ...
# Simulate candidates against the v3 interviewer: npm run ai:sim -- --case strong

# --- Developer tools ----------------------------------------------------------
# On in development (e.g. the account menu's Free/Plus switch); always off in production.
# DEV_TOOLS=false

# --- Voice answers ------------------------------------------------------------
# Plus learners can answer the interviewer by voice. Recordings are transcribed with
# Groq Whisper (free tier at https://console.groq.com); without a key, development uses
# a fake transcriber and production turns voice answers off.
# GROQ_API_KEY=
# On in development; in production set VOICE_ANSWERS=true (and GROQ_API_KEY) to enable.
# VOICE_ANSWERS=false

# --- Scheduled maintenance ---------------------------------------------------
# Bearer secret Vercel Cron sends to /api/v1/internal/maintenance. Unset = endpoint disabled.
# CRON_SECRET=

# --- Server -----------------------------------------------------------------
# PORT=8787
# APP_ORIGIN=https://your-domain.example
# TRUST_PROXY=1
# VERCEL_DEPLOY_HOOK_URL=        # production rebuild after an article is published or unpublished
