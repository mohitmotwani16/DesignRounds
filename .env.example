# Copy to .env and fill in what you need. Every value is optional for local development.

# --- Database ---------------------------------------------------------------
# Leave unset to use the embedded local Postgres (PGlite) stored in .data/pglite.
# Set to a free cloud Postgres (Neon or Supabase) connection string to use that instead.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Required in production. On Supabase use the pooler's "Transaction" connection string (port 6543).
# DATABASE_POOL_SIZE=5
# Optional separate connection for `npm run db:migrate` (e.g. Supabase "Session" pooler, port 5432).
# MIGRATION_DATABASE_URL=

# --- Sign-in codes ----------------------------------------------------------
# Required in production. Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# With no provider configured (and NODE_ENV not production), codes are printed
# in the API terminal and shown on the sign-in screen.

# Option A: SMTP, e.g. Gmail with an app password (https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=DesignRounds <you@gmail.com>

# Option B: Resend (https://resend.com). Without a verified domain it only delivers to your own address.
# RESEND_API_KEY=
# EMAIL_FROM=DesignRounds <onboarding@resend.dev>

# --- AI ---------------------------------------------------------------------
# Leave AI_API_KEY unset in development to use the built-in fake provider, which
# returns clearly labelled sample reviews. In production AI stays off until configured.
#
# Free development key: Google AI Studio (https://aistudio.google.com/apikey).
# Free-tier requests may be used by Google to improve its products: use test data only.
# AI_API_KEY=
# AI_MODEL=gemini-3.8-flash      # run `npm run ai:check` to list models your key can use
#
# Any other OpenAI-compatible API works the same way, e.g. Groq:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
#
# Optional tuning (defaults shown):
# AI_PROVIDER=                   # openai-compat | fake (inferred when unset)
# AI_REVIEW_EFFORT=medium        # reasoning effort: low | medium | high
# AI_REVIEW_MAX_TOKENS=12000
# AI_REVIEW_TIMEOUT_MS=120000

# --- Developer tools ----------------------------------------------------------
# On in development (e.g. the account menu's Free/Plus switch); always off in production.
# DEV_TOOLS=false

# --- Scheduled maintenance ---------------------------------------------------
# Bearer secret Vercel Cron sends to /api/v1/internal/maintenance. Unset = endpoint disabled.
# CRON_SECRET=

# --- Server -----------------------------------------------------------------
# PORT=8787
# APP_ORIGIN=https://your-domain.example
# TRUST_PROXY=1
