            "id": "incident.fix_ci",
            "stage": "incident",
            "dimension": "requirements",
            "weight": 3,
            "required": true,
            "goal": "Gate releases on evaluation results.",
            "opener": "How do evaluation results actually stop a bad change from shipping?",
            "evidence": {
              "strong": "CI runs the relevant suites on every change to prompts, models, retrieval or tools; gates per slice (critical slices such as safety must not regress at all) plus overall thresholds and cost and latency limits; clear reports in the pull request; documented overrides with approval; canaries after passing.",
