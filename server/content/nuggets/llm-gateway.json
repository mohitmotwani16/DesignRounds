      "miniPack": {
        "agenda": [
          {
            "id": "incident.fix_limits",
            "stage": "incident",
            "dimension": "scalability",
            "weight": 3,
            "required": true,
            "goal": "Enforce token rate limits and spend budgets.",
            "opener": "How do you enforce a team's budget when a request's cost isn't known until it finishes?",
            "evidence": {
              "strong": "Limits by tokens and spend, not request counts, at organisation, team, tenant and user levels; estimates and reserves input tokens before the call, reconciles actual input and output afterwards; counters in a shared fast store with atomic updates; alerts at thresholds; reserved capacity for critical traffic; smooths bursts against provider limits.",
              "adequate": "Request-count limits per team.",
              "weak": "No limits."
            },
            "misconceptions": [
              {
                "id": "lim.requests",
                "pattern": "Rate-limits by number of requests.",
                "challenge": "One request uses a hundred tokens, another a hundred thousand. Are they equal?"
              }
            ],
            "probes": [
              "When do you charge for output tokens?",
              "What happens at a hundred percent of budget?"
            ],
            "hints": [
              "Reserve, then reconcile.",
              "Tokens are the real unit."
            ],
            "referenceFix": "Token and spend limits at several levels, reserve-then-reconcile, atomic shared counters, threshold alerts and reserved capacity."
          }
        ],
        "pacing": {
