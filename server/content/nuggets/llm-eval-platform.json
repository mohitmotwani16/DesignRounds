        "headline": "Uncalibrated LLM grader produces non-reproducible eval scores"
      },
      "miniPack": {
        "agenda": [
          {
            "id": "incident.fix_graders",
            "stage": "incident",
            "dimension": "data",
            "weight": 3,
            "required": true,
            "goal": "Grade outputs reliably.",
            "opener": "How do you grade open-ended outputs, and how do you know your grader is right?",
            "evidence": {
              "strong": "Code checks wherever possible (schema, required facts, tool calls), reference comparisons, LLM judges with specific rubrics and binary or few-level scales, calibrated against a few hundred human labels per dimension and slice, controlled for position, length and self-preference bias, versioned and re-calibrated on change; humans for high-stakes slices.",
              "adequate": "An LLM judge with a general quality score.",
              "weak": "Exact string match only."
            },
            "misconceptions": [
              {
                "id": "gr.trust",
                "pattern": "Trusts an LLM judge out of the box.",
                "challenge": "The judge prefers longer answers. What happens to teams' prompts over time?"
              }
            ],
            "probes": [
              "How do you measure judge agreement with people?",
              "Which checks don't need a model at all?"
            ],
            "hints": [
              "Cheap, exact checks first.",
              "Compare judges with human labels."
            ],
            "referenceFix": "Code checks first, rubric-based judges calibrated on human labels with bias controls, versioned judges, humans for high stakes."
          }
        ],
        "pacing": {
          "incident": 0.85,
          "wrap_up": 0.15
        }
      },
      "status": "published",
      "source": "cursor"
