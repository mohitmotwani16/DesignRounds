      "miniPack": {
        "agenda": [
          {
            "id": "incident.fix_trials",
            "stage": "incident",
            "dimension": "tradeoffs",
            "weight": 3,
            "required": true,
            "goal": "Make comparisons trustworthy despite variable outputs.",
            "opener": "The same case passes on one run and fails on the next. How do you decide whether a change is better?",
            "evidence": {
              "strong": "Runs each case several times, reports pass rates with confidence intervals, compares candidate and baseline on the same cases (paired comparison), breaks results down by slice, and sets minimum detectable differences before declaring wins.",
              "adequate": "Averages scores from one run.",
              "weak": "Eyeballs results."
            },
            "misconceptions": [
              {
                "id": "tr.once",
                "pattern": "Runs each case once.",
                "challenge": "A change improves the score by one point on a single run. Is that real?"
              }
            ],
            "probes": [
              "How many runs per case are enough?",
              "How do you compare two versions fairly?"
            ],
            "hints": [
              "Variance needs repetition.",
              "Same cases, both versions."
            ],
            "referenceFix": "Repeated trials, pass rates with confidence intervals, paired comparisons with the baseline and slice breakdowns."
          }
        ],
