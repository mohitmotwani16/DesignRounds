      "miniPack": {
        "agenda": [
          {
            "id": "incident.fix_batching",
            "stage": "incident",
            "dimension": "scalability",
            "weight": 3,
            "required": true,
            "goal": "Maximise throughput while protecting latency.",
            "opener": "How do you keep GPUs busy without making interactive users wait?",
            "evidence": {
              "strong": "Continuous batching that adds and removes sequences each step, a paged KV cache to avoid fragmentation, chunked prefill so long prompts don't stall decoding, batch size and admission limits tuned for time to first token, and prefix caching for shared system prompts.",
              "adequate": "Dynamic batching with a wait window.",
              "weak": "One request at a time or static batches."
            },
            "misconceptions": [
              {
                "id": "bat.static",
                "pattern": "Waits to fill a fixed batch before running.",
                "challenge": "A batch of sequences finishes at different lengths. What do the GPU slots of finished sequences do?"
              }
            ],
            "probes": [
              "What does a long prompt do to everyone else's decoding?",
              "How do you trade throughput for latency?"
            ],
            "hints": [
              "Join and leave the batch every step.",
              "Split big prefills."
            ],
            "referenceFix": "Continuous batching, paged KV cache, chunked prefill, tuned admission and batch limits, and prefix caching."
          }
        ],
        "pacing": {
          "incident": 0.85,
          "wrap_up": 0.15
        }
      },
