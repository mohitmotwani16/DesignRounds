{
  "name": "designrounds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server --watch-path=src/data server/index.js",
    "dev:web": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:deploy": "node scripts/migrate.js && npm run build",
    "check:build": "node scripts/check-learn.mjs && node scripts/check-build.mjs",
    "start": "node server/index.js",
    "db:migrate": "node scripts/migrate.js",
    "test:smoke": "node scripts/smoke.js",
    "preview": "vite preview --host 0.0.0.0",
    "ai:check": "node scripts/ai-check.js",
    "ai:costs": "node scripts/ai-costs.js",
    "ai:eval": "node scripts/ai-eval.js",
    "ai:sim": "node scripts/interview-sim.js",
    "ai:round": "node scripts/round-eval.js",
    "answers:build": "node scripts/build-answer-pools.js",
    "packs:build": "node scripts/build-packs.js",
    "packs:audit": "node scripts/audit-packs.js",
    "test:answers": "node --test server/modules/answers/answers.test.js",
    "test:stream": "node --test server/modules/ai/message-stream.test.js",
    "test:scoring": "node --test server/modules/ai/scoring.test.js",
    "test:vertex": "node --test server/modules/ai/anthropic-vertex.test.js server/modules/ai/gemini-vertex.test.js server/modules/ai/pricing.test.js",
    "test:conductor": "node --test server/modules/ucs/ucs.test.js server/modules/pks/pks.test.js server/modules/conductor/conductor.test.js server/modules/conductor/gate.test.js server/modules/conductor/canvas.test.js server/modules/conductor/data-model.test.js",
    "test:learn-linkify": "node --test src/learn/linkify.test.js",
    "test:smoke:v3": "node scripts/smoke-conductor.js",
    "theme": "node scripts/theme-tokens.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@anthropic-ai/vertex-sdk": "0.20.4",
    "@aws-sdk/client-s3": "3.1152.0",
    "@electric-sql/pglite": "0.4.6",
    "@vercel/functions": "3.10.1",
    "@xyflow/react": "12.12.0",
    "cookie-parser": "1.4.7",
    "express": "4.22.3",
    "google-auth-library": "11.1.0",
    "lucide-react": "0.577.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "posthog-js": "1.438.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "simple-icons": "13.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.2",
    "vite": "6.4.4"
  },
  "overrides": {
    "zod": "$zod"
  }
}
