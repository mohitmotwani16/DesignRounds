# Copy to .env and fill in what you need. Every value is optional for local development.

# --- Database ---------------------------------------------------------------
# Leave unset to use the embedded local Postgres (PGlite) stored in .data/pglite.
# Set to a free cloud Postgres (Neon or Supabase) connection string to use that instead.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Sign-in codes ----------------------------------------------------------
# Required in production. Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# With no provider configured (and NODE_ENV not production), codes are printed
# in the API terminal and shown on the sign-in screen.

# Option A: SMTP, e.g. Gmail with an app password (https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=DesignRounds <you@gmail.com>

# Option B: Resend (https://resend.com). Without a verified domain it only delivers to your own address.
# RESEND_API_KEY=
# EMAIL_FROM=DesignRounds <onboarding@resend.dev>

# --- Server -----------------------------------------------------------------
# PORT=8787
# APP_ORIGIN=https://your-domain.example
# TRUST_PROXY=1
