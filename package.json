{
  "name": "designrounds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server --watch-path=src/data server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "build:deploy": "node scripts/migrate.js && vite build",
    "start": "node server/index.js",
    "db:migrate": "node scripts/migrate.js",
    "test:smoke": "node scripts/smoke.js",
    "preview": "vite preview --host 0.0.0.0",
    "ai:check": "node scripts/ai-check.js",
    "ai:eval": "node scripts/ai-eval.js",
    "theme": "node scripts/theme-tokens.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@vercel/functions": "3.9.9",
    "@xyflow/react": "12.3.6",
    "cookie-parser": "1.4.7",
    "express": "4.22.3",
    "lucide-react": "1.55.0",
    "nodemailer": "10.0.12",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "simple-icons": "13.21.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "vite": "6.4.3"
  }
}
