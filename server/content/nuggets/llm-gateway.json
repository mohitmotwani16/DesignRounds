        "headline": "Aggressive retries without backoff worsen provider failure cascade"
      },
      "miniPack": {
        "agenda": [
          {
            "id": "incident.fix_fallback",
            "stage": "incident",
            "dimension": "reliability",
            "weight": 3,
            "required": true,
            "goal": "Survive provider failures without making them worse.",
            "opener": "Provider A starts failing half its requests. Walk me through what the gateway does.",
            "evidence": {
              "strong": "Retries only retryable errors (timeouts, rate limits, server errors) with backoff and jitter, opens a circuit breaker for the failing provider, falls back along an ordered chain with prompt variants tuned per model, alerts when primary and fallback both fail, and evaluates fallback paths like releases.",
              "adequate": "Retries and falls back without breakers or per-model prompts.",
              "weak": "Returns errors."
            },
            "misconceptions": [
              {
                "id": "fb.retry_all",
                "pattern": "Retries every failed request.",
                "challenge": "The request has an invalid parameter. What do retries achieve?"
              }
            ],
            "probes": [
              "Which errors are worth retrying?",
              "Does the same prompt work on the fallback model?"
            ],
            "hints": [
              "Some failures will never succeed.",
              "Different models need different prompts."
            ],
            "referenceFix": "Retries on retryable errors with backoff, circuit breakers, ordered fallbacks with per-model prompts, and alerts on cascading failure."
          }
        ],
        "pacing": {
          "incident": 0.85,
          "wrap_up": 0.15
        }
      },
      "status": "published",
